# Copy to .env.local (gitignored) and fill in from your Supabase project's
# Project Settings -> API. Vite only exposes vars prefixed with VITE_ to the
# client bundle, which is what we want: both of these are public-by-design
# (the anon/publishable key is meant to ship to browsers; row-level security
# in persistent-classes/schema.sql is what actually constrains it).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key
